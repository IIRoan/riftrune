{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://riftapi.solace.onl"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://riftapi.solace.onl"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "main": {
      "channel": "main",
      "environment": "production",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://riftapi.solace.onl"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
